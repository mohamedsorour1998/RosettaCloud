<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>app.rosettacloud</groupId>
    <artifactId>rosettacloud-backend-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>RosettaCloud Backend Parent</name>
    <description>Enterprise Spring Boot 4 microservices migration of the RosettaCloud backend</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Versions not managed by the Spring Boot BOM -->
        <aws.sdk.version>2.46.18</aws.sdk.version>
        <fabric8.version>7.8.0</fabric8.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <!-- Spring Cloud release train (Oakwood, GA 2025-11-25): SF7 / Boot 4, all modules 5.0.0.
             Brings Spring Cloud CircuitBreaker 5.0.x (Resilience4j backend) for Part B (B.3). -->
        <spring-cloud.version>2025.1.0</spring-cloud.version>
        <!-- Resilience4j: aligned with the version Spring Cloud CircuitBreaker 5.0.0 wraps
             (resilience4j-core 2.3.0). Only needed to supply resilience4j-bulkhead, which the
             CircuitBreaker starter marks <optional> so it is not pulled transitively (B.3.1). -->
        <resilience4j.version>2.3.0</resilience4j.version>
        <!-- CVE-2025-14813 fix: force the transitive bcprov-jdk18on (from spring-cloud-context) to the
             1.81.1 patch. 1.81 is flagged CRITICAL (fixed in 1.80.2 / 1.81.1 / 1.84 per NVD/Trivy). -->
        <bouncycastle.version>1.81.1</bouncycastle.version>

        <!-- Build plugin versions (JaCoCo is not in the Spring Boot BOM) -->
        <jacoco.version>0.8.13</jacoco.version>
    </properties>

    <modules>
        <module>shared-lib</module>
        <module>user-service</module>
        <module>question-service</module>
        <module>lab-service</module>
        <module>chat-service</module>
        <module>analytics-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- AWS SDK for Java v2 (DynamoDB, S3, Cognito, Bedrock, BedrockAgentCore, STS, SNS, SQS) -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Testcontainers (localstack + junit-jupiter modules live on the 1.x line) -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Fabric8 Kubernetes client (lab-service lifecycle + question-service in-pod exec) -->
            <dependency>
                <groupId>io.fabric8</groupId>
                <artifactId>kubernetes-client-bom</artifactId>
                <version>${fabric8.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud release train BOM (Oakwood 2025.1.0). Imported last so it only supplies
                 versions the Boot/AWS/Fabric8 BOMs above do not already manage. Provides
                 spring-cloud-starter-circuitbreaker-resilience4j (Circuit Breaker, Part B §B.3). -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Resilience4j BOM — pins every resilience4j module to one version (spring-cloud-dependencies
                 does NOT manage resilience4j). Lets modules add the <optional> resilience4j-bulkhead
                 without a hard-coded version, aligned with the 2.3.0 the CircuitBreaker starter wraps. -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- SECURITY (CVE-2025-14813, CRITICAL): spring-cloud-context 5.0.0 transitively pulls
                 org.bouncycastle:bcprov-jdk18on:1.81 (GOSTCTR flaw). It is the ONLY BouncyCastle
                 artifact on the classpath and is used only by spring-cloud-context for {cipher}
                 config decryption, which no service uses. Pin to the 1.81.1 patch (fixed per NVD)
                 to clear the Trivy CRITICAL gate while keeping the crypto provider available. -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Code coverage for the enterprise CI gate -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <!-- Exclude non-unit-testable code from the gate: framework glue, DTOs,
                                     and infra adapters that are covered by integration/e2e tests instead
                                     (repositories, Redis stores, RestClient clients, AWS/K8s invokers). -->
                                <excludes>
                                    <exclude>**/*Application.*</exclude>
                                    <exclude>**/config/**</exclude>
                                    <exclude>**/*Properties.*</exclude>
                                    <exclude>**/web/dto/**</exclude>
                                    <exclude>**/client/**</exclude>
                                    <exclude>**/persistence/**</exclude>
                                    <exclude>**/*Invoker.*</exclude>
                                    <exclude>**/Fabric8*.*</exclude>
                                    <exclude>**/*Janitor.*</exclude>
                                    <exclude>**/*Redis*.*</exclude>
                                </excludes>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.40</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Coverage is enabled for every module by default -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
